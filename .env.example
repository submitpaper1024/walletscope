# Copy this file to .env and fill in local values. Loaded by walletscope/config.py.

# === Wallet driver (Phase 2) ===

# Password for the wallet extension; typed by pswdInput() during unlock.
WALLET_PASSWORD=

# Chrome remote-debugging profile with the wallet extensions installed.
# Default: ~/chrome_selenium_profile / "Profile 9".
CHROME_PROFILE_DIR=
CHROME_PROFILE_NAME=Profile 9

# Chrome binary path (macOS default below).
CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Chrome DevTools Protocol port (used by the driver to attach to extension popups).
CDP_PORT=9222


# === DApp server (Phase 1) ===

# The DApp http.server binds to DAPP_BIND. Some wallets reject 127.0.0.1
# origins; if so, set DAPP_BIND to a LAN IP and map a friendly hostname
# to it in /etc/hosts. DAPP_URL is what the browser navigates to.
DAPP_BIND=127.0.0.1
DAPP_PORT=8080
DAPP_URL=http://127.0.0.1:8080/index.html


# === Proxy (Phase 3) ===

# mitmproxy listening port. The driver routes Chrome traffic through it
# when WALLETSCOPE_USE_PROXY=1.
MITMPROXY_PORT=8081
WALLETSCOPE_USE_PROXY=0

# Output directories (relative to project root).
WALLETSCOPE_LOG_DIR=walletscope/data/captures
WALLETSCOPE_REPORT_DIR=walletscope/data/reports


# === Claude API (Phase 3) ===

# Used by walletscope/proxy/classifier.py for AI-assisted provider naming.
ANTHROPIC_API_KEY=
